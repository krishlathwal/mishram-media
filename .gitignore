# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# visual QA output — the default out dir of `scripts/shoot.mjs`, which also
# keeps a throwaway Chrome profile inside it. The captures are dev artifacts in
# the same class as `.next`: a phase is reviewed from them and the roadmap
# records what they showed, so the files themselves never belong in the remote.
/shots/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries variable names and no values. It is the
# documentation for what production needs configured (§10h).
!.env.example

# supabase — the CLI's local working state. `supabase/migrations/` IS tracked
# and is the point of the directory; everything below holds link state, local
# stack credentials and temporary files, none of which belongs in the remote.
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# netlify
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
