# Variable NAMES only. No real value ever belongs in this file — it is tracked
# in git precisely so it can document what production needs without carrying it.

# Scheduling link for the "Book a 15-Min Call" CTA.
# Leave empty until a real calendar exists — every booking CTA then falls back
# to a WhatsApp conversation requesting the free 15-minute consultation.
NEXT_PUBLIC_BOOKING_URL=

# ── Lead capture ────────────────────────────────────────────────────────────
# The Supabase project behind `public.leads`. Read only by the server, through
# src/lib/supabase/server.ts, which is `import "server-only"` — a client
# component that imports it fails the build rather than leaking anything.
#
# THE DATABASE IS THE SOURCE OF TRUTH. Without these two, /api/inquiry answers
# `storage_not_configured` and the form says plainly that the site is not set up
# to receive inquiries yet, then offers WhatsApp. No success is ever faked.

# https://<project-ref>.supabase.co
SUPABASE_URL=

# **SECRET. SERVER ONLY. NEVER NEXT_PUBLIC_, never imported in the browser.**
# This key's role bypasses Row Level Security, which is why `public.leads` has
# RLS on with no policies at all: everything is denied except this.
#
# Set ONE of the two. `SUPABASE_SECRET_KEY` takes precedence when both are set.
#   SUPABASE_SECRET_KEY       — the current format, `sb_secret_…`
#   SUPABASE_SERVICE_ROLE_KEY — the legacy `service_role` JWT
# Dashboard → Project Settings → API Keys.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Inquiry notification email ──────────────────────────────────────────────
# Read only by the server route at app/api/inquiry/route.ts. None of these is
# NEXT_PUBLIC_, so none of them reaches the browser — the form posts to our own
# route and the route is the only thing that holds the credential.
#
# NOTIFICATION ONLY. The lead is stored before this is attempted, so with any of
# the three missing the inquiry is still captured, the visitor still gets an
# honest success, and the row records `email_notification_status` as
# `not_configured` (or `failed`, with a short reason). Nothing is ever lost to a
# delivery problem.

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. **Requires a domain verified with Resend** — there is
# deliberately no default, because inventing one (leads@mishram.media, say)
# would look configured and then fail at send time. Format: "Name <a@b.com>"
# or a bare address.
INQUIRY_FROM_EMAIL=

# Where inquiries land. Optional — defaults to CONTACT.email in config/site.ts,
# which is Mishram's real published address.
INQUIRY_TO_EMAIL=

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# The GA4 measurement id, `G-…`. **NOT a secret** — it is visible in the page
# source of every site that runs GA, which is why this one is NEXT_PUBLIC_ and
# everything above it is not. It is an env var for *environment control*.
#
# SET IT ON VERCEL **PRODUCTION ONLY**. Leaving it empty here is deliberate and
# is the entire dev/preview protection:
#
#   Production          → the tag loads, real traffic is measured
#   Vercel Preview      → empty, nothing renders, nothing is sent
#   next dev / local    → empty, nothing renders, nothing is sent
#
# Setting it locally is not forbidden — hits from a non-production build carry
# `debug_mode`, so they land in GA4's DebugView rather than the reports — but
# the default is off, and a developer never has to dismiss a consent notice.
#
# With it empty, `config/analytics.ts` reports `analyticsEnabled: false`, no
# script is rendered, and every helper in `lib/analytics.ts` no-ops. The site
# behaves identically in every other respect.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
